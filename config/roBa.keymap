#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W        &kp E         &kp R          &kp T                                          &kp Y            &kp U           &kp I      &kp O        &kp P
&mt LCTRL A  &mt LSHFT S  &kp D         &lt 5 F        &mt LALT G   &kp LS(LG(S))      &kp MINUS      &mt RIGHT_ALT H  &mt LEFT_GUI J  &kp K      &mt RSHFT L  &mt RCTRL SEMICOLON
&kp Z        &kp X        &kp C         &kp V          &kp B        &kp COLON          &kp SEMICOLON  &kp N            &kp M           &kp COMMA  &kp DOT      &kp SLASH
&kp LCTRL    &kp LSHFT    &kp LEFT_ALT  &kp BACKSPACE  &lt 1 ENTER  &lt 3 ESC          &lt 3 TAB      &lt 2 SPACE                                              &none
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        SYMBOL {
            bindings = <
&kp RS(N1)       &kp AT_SIGN          &kp HASH          &kp DOLLAR         &kp PERCENT                       &kp CARET            &kp AMPERSAND   &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&mt LCTRL GRAVE  &mt LSHFT BACKSLASH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_ALT  &trans      &trans  &mt RIGHT_ALT EQUAL  &kp MINUS       &kp DOUBLE_QUOTES  &mt RSHFT SQT         &kp RCTRL
&kp TILDE        &kp PIPE             &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans        &trans      &trans  &kp PLUS             &kp UNDERSCORE  &trans             &trans                &trans
&trans           &trans               &trans            &trans             &trans        &trans      &trans  &trans                                                                        &trans
            >;
        };

        NUM {
            bindings = <
&trans     &kp N7  &kp N8  &kp N9  &kp PLUS                      &kp CARET            &kp AMPERSAND   &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LCTRL  &kp N4  &kp N5  &kp N6  &kp LALT  &trans      &trans  &mt RIGHT_ALT EQUAL  &kp MINUS       &kp DOUBLE_QUOTES  &mt RSHIFT SQT        &kp RCTRL
&kp N0     &kp N1  &kp N2  &kp N3  &kp N0    &trans      &trans  &kp PLUS             &kp UNDERSCORE  &kp COMMA          &kp PERIOD            &kp SLASH
&trans     &trans  &trans  &trans  &trans    &trans      &trans  &trans                                                                        &trans
            >;
        };

        FUNCTION-ARROW {
            bindings = <
&trans     &kp F7  &kp F8  &kp F9  &kp F12                            &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)  &trans
&kp LCTRL  &kp F4  &kp F5  &kp F6  &kp F11  &trans         &trans     &kp LEFT            &kp DOWN_ARROW      &kp UP_ARROW      &kp RIGHT_ARROW      &trans
&trans     &kp F1  &kp F2  &kp F3  &kp F10  &trans         &trans     &kp HOME            &kp PAGE_DOWN       &kp PAGE_UP       &kp END              &trans
&trans     &trans  &trans  &trans  &trans   &kp LANG1      &kp LANG2  &trans                                                                         &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &mkp MB1  &mkp MB2  &mo 5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
